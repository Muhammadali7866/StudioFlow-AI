# StudioFlow AI - Environment Variables Template

# Express API Server Port & URL
PORT=4000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=studioflow-ai-dev
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./keys/gcp-service-account.json

# Google Firestore Configuration
FIRESTORE_DATABASE_ID=(default)

# Google Cloud Storage Configuration
GOOGLE_CLOUD_STORAGE_BUCKET=studioflow-ai-media-dev

# Google Gemini / ADK Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Grafana Cloud / OpenTelemetry metrics (leave unset to disable export)
# GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
# GRAFANA_CLOUD_INSTANCE_ID=your-instance-id
# GRAFANA_CLOUD_API_KEY=your-cloud-access-policy-token
# Alternatively, send to a local OpenTelemetry Collector or Grafana Alloy:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20base64-credentials
GRAFANA_METRICS_EXPORT_INTERVAL_MS=15000
GRAFANA_METRICS_EXPORT_TIMEOUT_MS=5000
