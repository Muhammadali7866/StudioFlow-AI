# StudioFlow AI - Environment Variables Template

# Express API Server Port & URL
PORT=4000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=studioflow-ai-dev
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./keys/gcp-service-account.json

# Google Firestore Configuration
FIRESTORE_DATABASE_ID=(default)

# Google Cloud Storage Configuration
GOOGLE_CLOUD_STORAGE_BUCKET=studioflow-ai-media-dev

# Google Gemini / ADK Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
